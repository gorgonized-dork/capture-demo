# Secrets: never commit
.env

# Run output stays local: it holds full source text. Deliberate synthetic
# examples belong under sample/expected/ instead.
runs/*
!runs/README.md

# Real inputs stay local: field notes, reviews, and decisions about real
# opportunities go under private/. Only the fictional sample is committed.
private/

# Caches
__pycache__/
*.pyc
.cache/
**/_cache/
.venv/

# Local tool settings
.claude/
